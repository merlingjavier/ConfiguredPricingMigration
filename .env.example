# SQL Server source, accessed read-only by the migration tool.
SQL_CONNECTION_STRING="Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True;"

# Operational database used by Discount Pricing S.
TARGET_MONGO_CONNECTION_STRING="mongodb://localhost:27017"
TARGET_MONGO_DATABASE="ConfiguredPricing"

# Optional explicit products and extraction batch size. Empty products uses all active products with active rates.
MIGRATION_BATCH_SIZE=10000
MIGRATION_PRODUCT_IDS=1028,1035,1041
